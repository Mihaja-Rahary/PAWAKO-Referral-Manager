# ==============================================================================
# PAWAKO REFERRAL MANAGER — VARIABLES D'ENVIRONNEMENT
# Architecture Gratuite (Firebase Spark + Backend Hébergé Gratuit + Discord OAuth2)
# ==============================================================================

# --- APPLICATION & URLS ---
# Port d'écoute du serveur Node.js / Express (défaut : 3000)
PORT=3000

# URL publique de l'application (Cloud Run, Render, Railway, ou domaine Firebase)
# Utilisé pour composer les URLs de retour OAuth2 et les liens absolus.
APP_URL="https://mon-domaine-pawako.example.com"

# URL publique du frontend si déployé séparément sur Firebase Hosting
# Ex: https://pawako-referral.web.app
FRONTEND_URL=""

# --- DISCORD OAUTH2 (Portail Discord Developer -> Applications -> OAuth2) ---
# Client ID de l'application Discord
DISCORD_CLIENT_ID=""

# Client Secret de l'application Discord (à garder strictement secret côté backend)
DISCORD_CLIENT_SECRET=""

# URL de redirection enregistrée dans le portail Discord (onglet OAuth2 > Redirects)
# Doit correspondre à : ${APP_URL}/auth/callback
DISCORD_REDIRECT_URI="https://mon-domaine-pawako.example.com/auth/callback"

# --- DISCORD BOT JARVIS (Passerelle Webhook & Intent Membres) ---
# Token du bot Discord JARVIS (pour inspecter les rôles ou synchroniser les membres)
DISCORD_BOT_TOKEN=""

# Secret partagé pour sécuriser le webhook entrant POST /api/discord/webhook (header X-JARVIS-Secret)
JARVIS_WEBHOOK_SECRET="pawako_secret_jarvis_securise_a_remplacer"

# --- ARCHITECTURE DES 4 SERVEURS DISCORD INDÉPENDANTS (Guild Snowflake IDs) ---
# 1. Accueil de tous les candidats (VA Chatting & VA Instagram)
DISCORD_RECRUITMENT_GUILD_ID="120000000000000001"

# 2. Réservé exclusivement aux VA Chatteurs en formation/simulation
DISCORD_FORMATION_GUILD_ID="120000000000000002"

# 3. Réservé aux VA Chatteurs validés en production
DISCORD_CHATTING_PRODUCTION_GUILD_ID="120000000000000003"

# 4. Réservé aux VA Instagram acceptés en production (aucun passage par formation)
DISCORD_INSTAGRAM_PRODUCTION_GUILD_ID="120000000000000004"

# --- SÉCURITÉ DU PREMIER ADMINISTRATEUR ---
# Seul l'utilisateur Discord ayant cet ID recevra le premier rôle ADMINISTRATEUR
# lors de sa première connexion sur /admin/login.
# Une fois réclamé, le verrouillage devient permanent dans la base.
PAWAKO_INITIAL_ADMIN_DISCORD_ID="123456789012345678"

# --- BASE DE DONNÉES CLOUD FIRESTORE (Plan Gratuit Firebase Spark) ---
# Identifiant du projet Firebase (Console Firebase -> Paramètres du projet)
FIREBASE_PROJECT_ID=""

# Email du compte de service Firebase (GCP IAM Service Account)
# Ex: firebase-adminsdk-xxxxx@pawako-referral.iam.gserviceaccount.com
FIREBASE_CLIENT_EMAIL=""

# Clé privée du compte de service (format PEM, avec \n préservés)
FIREBASE_PRIVATE_KEY=""

# Mode de stockage : 'firestore' (si configuré) ou 'local' (repli automatique sur data/pawako_db.json)
STORAGE_MODE="local"
