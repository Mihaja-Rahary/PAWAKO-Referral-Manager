# ==============================================================================
# PAWAKO REFERRAL MANAGER — ARCHITECTURE CLOUDFLARE PAGES, WORKERS & FIREBASE
# Frontend : Cloudflare Pages (https://pawako-referral-manager.pages.dev)
# Backend API : Cloudflare Workers (referral-manager sur workers.dev)
# Base de Données : Cloud Firestore (Persistance unique via REST API)
# ==============================================================================

# --- FRONTEND (Cloudflare Pages — Variable d'environnement publique) ---
# URL de l'API Cloudflare Worker en production
# Configuré automatiquement via .env.production ou dans les variables Cloudflare Pages :
VITE_API_BASE_URL="https://referral-manager.pawako-saas.workers.dev"

# --- CLOUDFLARE WORKER : VARIABLES NON SECRÈTES (wrangler.jsonc -> vars) ---
# ID du projet Firebase et ID de base de données Firestore
FIREBASE_PROJECT_ID="gen-lang-client-0255826431"
FIREBASE_DATABASE_ID="ai-studio-pawakoreferralma-1d4a1a22-a715-4552-b717-2e03e349fbee"

# URL publique du Frontend Cloudflare Pages
FRONTEND_URL="https://pawako-referral-manager.pages.dev"

# URL de redirection OAuth2 Discord
DISCORD_REDIRECT_URI="https://referral-manager.pawako-saas.workers.dev/auth/callback"

# Les 4 Guild IDs des serveurs Discord PAWAKO indépendants (remplir avec les vrais identifiants)
DISCORD_RECRUITMENT_GUILD_ID=""
DISCORD_FORMATION_GUILD_ID=""
DISCORD_CHATTING_PRODUCTION_GUILD_ID=""
DISCORD_INSTAGRAM_PRODUCTION_GUILD_ID=""

# --- CLOUDFLARE WORKER : SECRETS CHIFFRÉS (Configurer via `npx wrangler secret put`) ---
# Exécuter les commandes suivantes dans votre terminal :
#
# 1. Secret Discord Client Secret :
#    npx wrangler secret put DISCORD_CLIENT_SECRET
#
# 2. Discord Client ID :
#    npx wrangler secret put DISCORD_CLIENT_ID
#
# 3. Premier Administrateur Discord User ID (seul habilité à réclamer le rôle) :
#    npx wrangler secret put INITIAL_ADMIN_DISCORD_ID
#
# 4. Email du compte de service Google/Firebase :
#    npx wrangler secret put FIREBASE_CLIENT_EMAIL
#
# 5. Clé privée du compte de service Google (format PEM avec en-tête et sauts de ligne) :
#    npx wrangler secret put FIREBASE_PRIVATE_KEY
#
# 6. Secret partagé du Webhook Bot JARVIS :
#    npx wrangler secret put JARVIS_WEBHOOK_SECRET
#
# 7. Clé secrète de signature des sessions et states OAuth2 (32+ caractères aléatoires requis) :
#    npx wrangler secret put SESSION_SECRET
#
